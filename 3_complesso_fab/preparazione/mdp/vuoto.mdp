; energia a singolo punto in vuoto per il controllo incrociato GROMACS/OpenMM dei termini legati e 1-4 (04)
integrator     = md
nsteps         = 0
cutoff-scheme  = Verlet
pbc            = xyz
coulombtype    = Cut-off
rcoulomb       = 1.0
vdwtype        = Cut-off
rvdw           = 1.0
DispCorr       = no
constraints    = none
nstcalcenergy  = 1
nstenergy      = 1
nstlog         = 1
