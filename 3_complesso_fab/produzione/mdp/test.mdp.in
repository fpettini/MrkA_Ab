; test di velocita': NVT con restraint, stessi parametri non legati delle apo (xray/equil_s1.mdp)
define                   = -DPOSRES -DPOSRES_FC=1000
integrator               = md
dt                       = @DT@
nsteps                   = @NSTEPS@
mass-repartition-factor  = @HMR@
continuation             = no
gen-vel                  = yes
gen-temp                 = 298
gen-seed                 = 12345
constraints              = h-bonds
constraint-algorithm     = LINCS
cutoff-scheme            = Verlet
nstlist                  = 100
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.2
rlist                    = 1.2
DispCorr                 = EnerPres
pbc                      = xyz
tcoupl                   = v-rescale
tc-grps                  = Protein_Other Water_and_ions
tau-t                    = 1.0   1.0
ref-t                    = 298 298
pcoupl                   = no
nstcomm                  = 100
comm-mode                = linear
comm-grps                = Protein_Other Water_and_ions
nstxout-compressed       = 0
nstenergy                = 5000
nstlog                   = 5000
