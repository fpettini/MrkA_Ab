; equil_s1: NVT, backbone 1000, zuccheri 200, anelli vincolati  (1 ns)
define                   = -DPOSRES -DPOSRES_FC=1000

integrator               = md
dt                       = 0.001
nsteps                   = 1000000
continuation             = no
gen-vel                  = yes
gen-temp                 = 310.15
gen-seed                 = -1

constraints              = h-bonds
constraint-algorithm     = LINCS

; --- non-bonded (AMBER ff14SB + GLYCAM06j + TIP3P/Joung-Cheatham) ---
cutoff-scheme            = Verlet
nstlist                  = 100
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.2
rlist                    = 1.2
DispCorr                 = EnerPres
pbc                      = xyz

; --- temperatura ---
tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau-t                    = 1.0   1.0
ref-t                    = 310.15 310.15

pcoupl                   = no
nstcomm                  = 100
comm-mode                = linear
comm-grps                = Protein Water_and_ions

; --- output ---
nstxout-compressed       = 25000
nstenergy                = 5000
nstlog                   = 5000
