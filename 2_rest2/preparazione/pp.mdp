; TEMPLATE REST2 -- 04_prepara_rest2.sh ne scrive una copia per replica sostituendo 0 e 1.
; Stessi parametri della produzione classica (md.mdp.in); cambiano solo:
; - parte da equil_s4 (backbone ancora vincolato) con velocita' nuove e senza restraint,
;   quindi i primi 20 ns vanno scartati in analisi;
; - nstcalcenergy esplicito: -replex deve esserne un multiplo;
; - si scrivono solo le coordinate della proteina, ogni 10 ps.

integrator               = md
dt                       = 0.002
nsteps                   = 0
continuation             = no
gen-vel                  = yes
gen-temp                 = 310.15
gen-seed                 = 1
ld-seed                  = 1
constraints              = h-bonds
constraint-algorithm     = LINCS

; --- non-bonded (AMBER ff14SB + TIP3P) ---
cutoff-scheme            = Verlet
nstlist                  = 100
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.2
rlist                    = 1.2
DispCorr                 = EnerPres
pbc                      = xyz

; --- temperatura: tutte le repliche a 310.15 K, la "temperatura" del soluto la fa la topologia scalata ---
tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau-t                    = 1.0   1.0
ref-t                    = 310.15 310.15

; --- pressione ---
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau-p                    = 5.0
compressibility          = 4.5e-5
ref-p                    = 1.0
refcoord-scaling         = com

nstcomm                  = 100
comm-mode                = linear
comm-grps                = Protein Water_and_ions

; --- output ---
nstcalcenergy            = 100
nstenergy                = 5000
nstlog                   = 5000
nstxout-compressed       = 5000
compressed-x-grps        = Protein
